#!/usr/bin/env python3
"""Stands in for the Claude Code command: fixed scores for made-up roles, and a record of each call.
The demo (evals/demo.py) brings its own scores and reasons, in scores.json in the made-up home folder."""
import json
import os
import sys

FLAGS = {"Senior Product Manager": ["Needs a made-up licence"]}
SCORES = {"Senior Product Manager": 9, "Product Manager, Growth": 6, "Product Owner": 3}
try:
    with open(os.path.join(os.environ["HOME"], "scores.json")) as f:
        SAID = json.load(f)  # {title: [score, why]}
except OSError:
    SAID = {}

SIGNED_OUT = os.path.join(os.environ["HOME"], "signed-out")
if sys.argv[1:3] == ["auth", "status"]:
    print(json.dumps({"loggedIn": not os.path.exists(SIGNED_OUT)}))
    sys.exit()
if sys.argv[1:3] == ["auth", "login"]:
    print("If the browser didn't open, visit: https://example.com/made-up-sign-in", flush=True)
    if sys.stdin.readline().strip() != "made-up-code":
        sys.exit("Login failed")
    os.remove(SIGNED_OUT)
    sys.exit()

prompt = sys.stdin.read()
if os.path.exists(SIGNED_OUT):
    print(json.dumps({"is_error": True, "result": "Failed to authenticate: OAuth session expired and could not be refreshed"}))
    sys.exit(1)
with open(os.path.join(os.environ["HOME"], "claude-calls.log"), "a") as log:
    log.write("call\n")
result = "[]"
if "## CV\n" in prompt:
    result = json.dumps({"titles": ["product manager", "product owner"], "places": ["London", "United Kingdom", "Remote"], "city": "London",
                         "country_code": "gb", "currency": "£", "level": "senior", "keywords": ["roadmap"], "employers": ["Made-up Ltd"],
                         "edge": ["A made-up strength"]})
if "## Roles (JSON)" in prompt:
    roles = json.loads(prompt[prompt.index("## Roles (JSON)\n") + 16:prompt.index("\n\nFor each role")])
    result = json.dumps([{"id": r["id"], "score": SAID.get(r["title"], [SCORES.get(r["title"], 5)])[0],
                          "why": SAID.get(r["title"], [0, f"Made-up reason for {r['title']}."])[1],
                          "flags": FLAGS.get(r["title"], []), "talk_to": "Head of Product"} for r in roles])
model = sys.argv[sys.argv.index("--model") + 1] if "--model" in sys.argv else "sonnet"
print(json.dumps({"result": result, "total_cost_usd": 0, "usage": {}, "modelUsage": {f"claude-{model}-9-9": {"costUSD": 0}}}))
