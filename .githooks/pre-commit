#!/usr/bin/env bash
# Code only: refuse commits that contain personal data or secrets.
# Enabled by: git config core.hooksPath .githooks   (install.sh does this)
set -euo pipefail
blocked='^(data/|profile/profile\.md$|watchlist\.csv$|content/|settings\.json$|\.secrets\.json$|\.x_token$|\.ntfy_topic$|\.cockpit_token$|\.companies_house_key$|\.env)'
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$blocked" || true)
if [[ -n "$bad" ]]; then
  echo "✋ pre-commit: these are personal data or secrets and must not be committed:"; echo "$bad" | sed 's/^/   /'
  exit 1
fi
if git diff --cached -U0 | grep '^+' | grep -qE 'sk-ant-[A-Za-z0-9_-]{20}|sk-[A-Za-z0-9]{32}|gh[pousr]_[A-Za-z0-9]{30}|AKIA[0-9A-Z]{16}|xox[baprs]-[0-9A-Za-z-]{20}|BEGIN [A-Z ]*PRIVATE KEY'; then
  echo "✋ pre-commit: staged changes look like they contain an API key or private key."
  exit 1
fi
# Your own email addresses and phone numbers, read from your private profile, must never appear in code.
if [[ -f profile/profile.md ]]; then
  ids=$(grep -oE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,}|\+?[0-9][0-9 ]{9,}[0-9]' profile/profile.md | sort -u || true)
  added=$(git diff --cached -U0 | grep '^+' || true)  # captured first: grep -q in a pipe trips pipefail
  while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    if grep -qF -- "$id" <<< "$added"; then
      echo "✋ pre-commit: staged changes contain personal details from your profile ($id). Remove them first."
      exit 1
    fi
  done <<< "$ids"
fi
